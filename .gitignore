*.env
api/env.js

# Session tokens and stored credentials.
# These were NOT covered before: *.env matches only names ENDING in .env, and
# a pasted access token has always been written as a bare tok.txt. A token file
# in the repo root was committable, and the DPAPI credential for the automation
# account would have been too. Names, not just patterns, because the thing that
# gets committed is whatever someone happened to call it.
tok.txt
token.txt
*.token
.dev.vars
*.cred.xml
.secrets/

